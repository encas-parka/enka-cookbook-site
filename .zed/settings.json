// Folder-specific settings
//
// For a full list of overridable settings, and general information on folder-specific settings,
// see the documentation: https://zed.dev/docs/configuring-zed#settings-files
{
  "file_scan_exclusions": [
    "/**_vendor/*",
    "**/node_modules/*",
    "/.claude/*",
    "**/.obsidian",
    "/.obsidian/*",
    "**/static/app/*",
    ".serena/cache/*"
  ],
  "file_scan_inclusions": [
    "appwrite/*",
    "appwrite-ec-dev/*",
    "docs/*",
    "content/*",
    "agent/*",
    ".agents/*",
    ".scratch/*",
    "AGENTS.md",
  ],
  "context_servers": {},
  "languages": {
    "Svelte": {
      // Format-on-save via bun fmt (CLI identique au pré-commit) — remplace la
      // chaîne language_server → prettier, incompatible avec la désinstallation
      // de prettier-plugin-svelte. Config : bunfig.toml [fmt].
      "formatter": {
        "external": {
          "command": "bun",
          "arguments": [
            "fmt",
            "--stdin-filepath",
            "{buffer_path}"
          ]
        }
      }
    },
    // Biome (extension Zed globale, actif même sans biome.json) désactivé sur ce
    // worktree : ses suggestions de tri d'imports ne sont rattachées à aucun
    // outil du repo. Reste actif sur les autres projets.
    "JavaScript": {
      "language_servers": [
        "!biome",
        "vtsls",
        "typescript-language-server",
        "eslint"
      ]
    },
    "TypeScript": {
      "language_servers": [
        "!biome",
        "vtsls",
        "typescript-language-server",
        "eslint"
      ]
    },
    "JSX": {
      "language_servers": [
        "!biome",
        "vtsls",
        "typescript-language-server",
        "eslint"
      ]
    },
    "TSX": {
      "language_servers": [
        "!biome",
        "vtsls",
        "typescript-language-server",
        "eslint"
      ]
    }
  },
}
