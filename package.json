{
  "name": "enka-cookbook-mig",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:pb": "bash scripts_dev/pb-dev.sh",
    "dev:app": "cd svelte-app && bun run dev",
    "dev:all": "concurrently \"cd svelte-app && bun run dev\" \"bash scripts_dev/pb-dev.sh\" --names \"VITE,PB\" --prefix-colors \"cyan,green\"",
    "build": "cd svelte-app && bun run build",
    "check": "bun check -b svelte-app/tsconfig.json",
    "check:app": "cd svelte-app && bun run check",
    "format": "bun fmt .",
    "format:check": "bun fmt --check ."
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
