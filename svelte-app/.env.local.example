# =============================================================================
# Stress Test Appwrite — Configuration Template (Revision 3 : API key admin)
# =============================================================================
# Copier ce fichier vers .env.local et remplir avec vos valeurs
# cp .env.local.example .env.local
#
# ⚠️ Ne JAMAIS committer .env.local (déjà ignoré par *.local dans .gitignore)
# =============================================================================

# --- API key admin ec-dev (OBLIGATOIRE) ---
# Créer dans Appwrite Console > Overview > API Keys > Create API Key
# Scopes requis :
#   - databases.read, databases.write
#   - tables.read, tables.write
#   - functions.read, functions.write
#   - users.read, users.write
#   - teams.read, teams.write
STRESS_API_KEY=standard_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- 6 users test (identifiés par email) ---
# Servent à identifier les virtual users (via users.list filtré par email)
# et à attribuer les labels du sandbox via CF add-label-to-user.
# Plus besoin de password : le script utilise l'API key admin pour tout.
STRESS_USER_1_EMAIL=user1@example.com
STRESS_USER_2_EMAIL=user2@example.com
STRESS_USER_3_EMAIL=user3@example.com
STRESS_USER_4_EMAIL=user4@example.com
STRESS_USER_5_EMAIL=user5@example.com
STRESS_USER_6_EMAIL=user6@example.com

# --- Paramètres du sandbox ---
# Nombre de products à créer dans le sandbox (avec productHugoUuid depuis recipes)
STRESS_PRODUCTS_COUNT=30
# Nombre de recipes à fetch pour obtenir des productHugoUuid valides (round-robin)
STRESS_RECIPES_COUNT=10

# --- Paramètres du test ---
# Nombre total de rafales (chaque rafale = 1 tour parallèle sur tous les users)
STRESS_RAFALES=100
# Durée max du test en ms (fallback si rafales non terminées)
STRESS_DURATION_MS=180000
# Délai aléatoire entre users dans une rafale (simule usage réaliste)
STRESS_JITTER_MIN_MS=100
STRESS_JITTER_MAX_MS=500

# --- Appwrite (optionnel, défauts depuis appwrite.ts) ---
STRESS_ENDPOINT=https://aw.oupla.net/v1
STRESS_PROJECT_ID=697a1fcf0005e3703e25    # ec-dev par défaut
STRESS_DATABASE_ID=689d15b10003a5a13636
