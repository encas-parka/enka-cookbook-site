{
  "name": "svelte-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:watch": "vite build --mode development --watch",
    "build": "vite build",
    "preview": "vite preview",
    "check-legacy": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "check": "svelte-check-native --output machine --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "check-for-human": "svelte-check-native --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.12.2",
    "@typescript/native-preview": "^7.0.0-dev.20260501.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "svelte-check-native": "^0.7.2",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@abhivarde/svelte-drawer": "^1.0.0",
    "@humanspeak/svelte-markdown": "^1.4.1",
    "@lucide/svelte": "^0.545.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@tiptap/core": "^3.22.3",
    "@tiptap/extension-highlight": "^3.22.3",
    "@tiptap/pm": "^3.22.3",
    "@tiptap/starter-kit": "^3.22.3",
    "appwrite": "24.2.0",
    "daisyui": "^5.5.19",
    "dexie": "^4.4.3",
    "fuse.js": "^7.3.0",
    "fuzzysort": "^3.1.0",
    "rune-scroller": "^2.2.2",
    "runed": "^0.37.1",
    "sv-router": "^0.13.0",
    "tailwindcss": "^4.2.2",
    "tiptap-markdown": "^0.9.0"
  }
}
