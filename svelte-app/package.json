{
  "name": "svelte-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:watch": "vite build --mode development --watch",
    "build": "vite build",
    "preview": "vite preview",
    "check-legacy": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "check": "svelte-check-native --incremental --output machine --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "check-for-human": "svelte-check-native --incremental --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-types": "pocketbase-typegen --db ../pocketbase/pb_data/data.db --out src/lib/types/pb-generated.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.2",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "pocketbase-typegen": "^1.5.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "svelte-check-native": "^1.9.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@abhivarde/svelte-drawer": "^2.0.1",
    "@humanspeak/svelte-markdown": "^2.1.3",
    "@lucide/svelte": "^1.59.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "daisyui": "^5.7.50",
    "dexie": "^4.4.6",
    "fuzzysort": "^4.0.2",
    "pocketbase": "^0.28.1",
    "runed": "^0.37.1",
    "sv-router": "^0.19.0",
    "tailwindcss": "^4.3.3",
    "tiptap-markdown": "^0.9.0"
  }
}
